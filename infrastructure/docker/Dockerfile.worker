FROM mcr.microsoft.com/playwright/python:v1.49.1-noble

WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DISPLAY=:99

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        xvfb \
        x11vnc \
        novnc \
        websockify \
        openbox \
        fonts-liberation \
        fonts-noto-color-emoji \
        procps \
    && rm -rf /var/lib/apt/lists/*

COPY workers/chromium/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir --ignore-installed -r /app/requirements.txt

COPY workers/chromium/agent /app/agent
COPY workers/chromium/entrypoint.sh /app/entrypoint.sh
RUN sed -i 's/\r$//' /app/entrypoint.sh && chmod +x /app/entrypoint.sh

EXPOSE 5900 6080
ENTRYPOINT ["/app/entrypoint.sh"]
